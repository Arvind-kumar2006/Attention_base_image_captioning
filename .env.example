# Copy to .env and fill in. Never commit the result.
#
#   cp .env.example .env
#   docker compose up --build
#
# There is deliberately no default for POSTGRES_PASSWORD: compose refuses to
# start without it rather than booting with a guessable credential.

# --- PostgreSQL -------------------------------------------------------------
# Required. Use a long random string: openssl rand -base64 24
POSTGRES_PASSWORD=
POSTGRES_DB=lumina
POSTGRES_USER=lumina

# --- Published port ---------------------------------------------------------
# The only port bound to the host. Postgres and the API are never published.
WEB_PORT=8080

# --- Frontend build ---------------------------------------------------------
# Same-origin by default: nginx proxies /api, so the client needs no
# host-specific URL. Set to an absolute URL to bypass the proxy in development.
VITE_API_URL=/api

# --- Backend ----------------------------------------------------------------
# Filename inside the weights volume. Seed the volume before `up`:
#   docker run --rm -v lumina_weights:/dst -v "$PWD/ml/weights:/src:ro" \
#     alpine cp /src/best.pt /dst/
CHECKPOINT_FILE=best.pt

# Must match the URL the browser uses to reach this stack, or CORS will reject
# it. Comma-separated for several origins.
FRONTEND_ORIGIN=http://localhost:8080
