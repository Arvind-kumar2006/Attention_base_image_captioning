# Backend configuration. Copy to .env and fill in; never commit the result.
# Every value here has a working default, so an empty .env still starts the API.

# Trained checkpoint loaded once at startup. Relative paths resolve from the
# repository root.
CHECKPOINT_PATH=ml/weights/best.pt

# cpu or cuda. CUDA requires torch built with CUDA support.
DEVICE=cpu

# Comma-separated origins allowed by CORS, or * for any.
FRONTEND_ORIGIN=http://localhost:5173

# SQLite by default. For PostgreSQL:
#   DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/lumina
DATABASE_URL=sqlite:///./app.db
DATABASE_ECHO=false

# Where uploaded originals are written.
UPLOAD_DIR=backend/uploads

# Uploads above this size are refused with HTTP 413.
MAX_UPLOAD_BYTES=10485760
